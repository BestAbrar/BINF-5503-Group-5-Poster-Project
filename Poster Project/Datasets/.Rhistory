pheatmap(mat_scaled,
color = colorRampPalette(rev(brewer.pal(n = 7, name = "RdBu")))(100),
annotation_col = annotation_col,
cluster_rows = TRUE,
cluster_cols = TRUE,
show_rownames = TRUE,
show_colnames = TRUE,
fontsize_row = 6,
main = "Top 50 Differentially Expressed Genes")
